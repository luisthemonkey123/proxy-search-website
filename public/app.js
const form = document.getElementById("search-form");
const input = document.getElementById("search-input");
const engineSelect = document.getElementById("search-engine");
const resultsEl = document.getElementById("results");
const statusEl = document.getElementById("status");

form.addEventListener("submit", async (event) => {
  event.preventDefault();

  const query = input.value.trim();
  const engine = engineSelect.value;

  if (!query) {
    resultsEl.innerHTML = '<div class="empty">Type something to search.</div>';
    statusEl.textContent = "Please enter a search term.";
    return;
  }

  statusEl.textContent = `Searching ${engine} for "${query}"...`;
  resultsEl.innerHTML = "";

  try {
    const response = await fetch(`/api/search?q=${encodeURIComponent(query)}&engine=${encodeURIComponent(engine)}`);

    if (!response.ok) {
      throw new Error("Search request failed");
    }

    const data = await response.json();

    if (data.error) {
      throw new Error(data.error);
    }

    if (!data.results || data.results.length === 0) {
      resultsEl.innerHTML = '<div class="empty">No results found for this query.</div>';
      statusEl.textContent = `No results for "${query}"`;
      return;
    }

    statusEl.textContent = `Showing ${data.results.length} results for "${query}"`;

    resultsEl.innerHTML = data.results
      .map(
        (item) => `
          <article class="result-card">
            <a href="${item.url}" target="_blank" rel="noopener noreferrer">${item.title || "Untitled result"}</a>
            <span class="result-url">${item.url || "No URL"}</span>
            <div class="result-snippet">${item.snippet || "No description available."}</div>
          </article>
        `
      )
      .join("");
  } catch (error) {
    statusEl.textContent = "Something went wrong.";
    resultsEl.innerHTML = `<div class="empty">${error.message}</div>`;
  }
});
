* {
  box-sizing: border-box;
}

:root {
  --bg: #07111f;
  --bg-2: #101b2d;
  --panel: rgba(17, 24, 39, 0.82);
  --panel-strong: rgba(15, 23, 42, 0.96);
  --border: rgba(148, 163, 184, 0.2);
  --text: #e2e8f0;
  --muted: #94a3b8;
  --accent: #60a5fa;
  --accent-2: #38bdf8;
  --success: #22c55e;
  --shadow: rgba(15, 23, 42, 0.45);
}

html, body {
  margin: 0;
  min-height: 100%;
  font-family: Inter, "Segoe UI", sans-serif;
  background: linear-gradient(160deg, var(--bg) 0%, var(--bg-2) 100%);
  color: var(--text);
}

body {
  min-height: 100vh;
}

.page-shell {
  width: min(1100px, 92vw);
  margin: 0 auto;
  padding: 28px 0 60px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 42px;
}

.brand {
  font-size: 1.2rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #dbeafe;
}

.content {
  display: flex;
  flex-direction: column;
  gap: 24px;
}

.hero {
  background: rgba(15, 23, 42, 0.72);
  border: 1px solid var(--border);
  border-radius: 24px;
  padding: 28px;
  box-shadow: 0 24px 60px var(--shadow);
}

.eyebrow {
  margin: 0 0 10px;
  color: var(--accent-2);
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.74rem;
  font-weight: 700;
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(2.2rem, 4vw, 4rem);
  line-height: 1.1;
  max-width: 660px;
}

.search-form {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12px;
  margin-top: 24px;
}

.search-box {
  flex: 1 1 500px;
  min-width: 220px;
}

input, select, button {
  font: inherit;
}

.search-box input {
  width: 100%;
  background: rgba(15, 23, 42, 0.95);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 14px;
  height: 56px;
  padding: 0 18px;
  font-size: 1.02rem;
  outline: none;
  transition: border 0.2s ease, box-shadow 0.2s ease;
}

.search-box input:focus,
select:focus {
  border-color: rgba(96, 165, 250, 0.9);
  box-shadow: 0 0 0 4px rgba(96, 165, 250, 0.16);
}

select {
  width: 180px;
  height: 56px;
  border-radius: 14px;
  border: 1px solid var(--border);
  background: rgba(15, 23, 42, 0.95);
  color: var(--text);
  padding: 0 16px;
  outline: none;
}

button {
  height: 56px;
  border: none;
  border-radius: 14px;
  background: linear-gradient(135deg, var(--accent), var(--accent-2));
  color: #06131d;
  font-weight: 800;
  padding: 0 24px;
  cursor: pointer;
  transition: transform 0.15s ease, filter 0.15s ease;
}

button:hover {
  filter: brightness(1.04);
  transform: translateY(-1px);
}

.status {
  margin-top: 16px;
  color: var(--muted);
  min-height: 24px;
}

.results {
  display: grid;
  gap: 16px;
}

.result-card {
  background: rgba(15, 23, 42, 0.82);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px 20px;
  box-shadow: 0 18px 32px rgba(15, 23, 42, 0.22);
}

.result-card a {
  color: #bfdbfe;
  text-decoration: none;
  font-size: 1.12rem;
  font-weight: 700;
}

.result-card a:hover {
  text-decoration: underline;
}

.result-url {
  display: block;
  margin-top: 8px;
  color: var(--success);
  font-size: 0.82rem;
  word-break: break-all;
}

.result-snippet {
  margin-top: 10px;
  color: var(--muted);
  line-height: 1.6;
}

.empty {
  background: rgba(15, 23, 42, 0.8);
  border: 1px solid var(--border);
  border-radius: 18px;
  padding: 18px 20px;
  color: var(--muted);
}

@media (max-width: 680px) {
  .search-form {
    flex-direction: column;
    align-items: stretch;
  }

  select,
  button {
    width: 100%;
  }
}
